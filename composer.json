{
    "name": "pavloniym/nova-action-buttons",
    "description": "Laravel Nova 5 field that runs resource actions from buttons on index and detail views.",
    "keywords": [
        "laravel",
        "nova",
        "nova-field",
        "actions",
        "buttons"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "pavloniym"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/nova": "^5.0"
    },
    "require-dev": {
        "laravel/nova-devtool": "^1.7",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Pavloniym\\ActionButtons\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pavloniym\\ActionButtons\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pavloniym\\ActionButtons\\FieldServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
